$include('../common/sdram_interfaces.si')

$$if ICARUS then
// SDRAM simulator
append('../common/mt48lc16m16a2.v')
import('../common/simul_sdram.v')
$$end

$$if ULX3S then
// Clock
// mport('../common/plls/ulx3s_50_25_100_100ph180.v')
// mport('../common/plls/ulx3s_160_25_160_160ph90.v')
import('pll.v')
$$end

