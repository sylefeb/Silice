$$end
$$if DE2 then
import('../common/plls/de2_25_100_100ph180.v')
$$end

$$if SIMULATION then
$$  TEST_SIZE = 1<<16
$$else
$$  TEST_SIZE = 1<<24
$$end

$include('../common/clean_reset.si')

import('inout16_set.v')
$$if ULX3S or ICEPI_ZERO then
import('inout16_ff_ulx3s.v')
import('out1_ff_ulx3s.v')
import('out2_ff_ulx3s.v')
import('out13_ff_ulx3s.v')
$$ULX3S_IO = true
$$end

// -------------------------

circuitry command(
  output sdram_cs,output sdram_ras,output sdram_cas,output sdram_we,input cmd)
{
  sdram_cs  = cmd[3,1];
  sdram_ras = cmd[2,1];
  sdram_cas = cmd[1,1];
  sdram_we  = cmd[0,1];
}

// SDRAM commands
$$CMD_dummy_WAIT_init = '1111'
$$CMD_dummy_WAIT      = '1101'
$$CMD_dummy_GET       = '1001'
$$CMD_UNSELECTED      = '1000'
$$CMD_NOP             = '0111'
$$CMD_ACTIVATE        = '0011'
$$CMD_READ            = '0101'
$$CMD_WRITE           = '0100'
$$CMD_TERMINATE       = '0110'
$$CMD_PRECHARGE       = '0010'
$$CMD_REFRESH         = '0001'
$$CMD_LOAD_MODE_REG   = '0000'
$$AddrZ     = '0000000000000'
$$AddrA_row = '0000000000000'
$$AddrA_col = '0000000000000'
$$AddrB_row = '0000000000001'
$$AddrB_col = '0000000000000'
$$Addr_wait_init     = '1111111111111'
$$Addr_wait_2        = '0000000000000' -- value are delay - 1 since using cnt sign bit to stop
$$Addr_wait_3        = '0000000000001' -- value are delay - 1 since using cnt sign bit to stop
$$Addr_wait_4        = '0000000000010'
$$Addr_wait_5        = '0000000000011'
$$Addr_wait_6        = '0000000000100'
$$Addr_wait_7        = '0000000000101'
$$Addr_wait_8        = '0000000000110'
$$Addr_wait_16       = '0000000001110'
$$Addr_precharge_all = '0010000000000'
$$Addr_mode_reg      = '0001000110011'
$$Bank0              = '00'
$$Bank1              = '01'
$$Bank2              = '10'
$$Bank3              = '11'
$$DataZ              = '0000000000000000'
// NOTE: sdram_ba: bank on bits 25-24 ( 2 bits)
//       sdram_a : row  on bits 22-10 (13 bits)
$$if ICARUS then
$$  Addr_wait_R = Addr_wait_4
$$else
$$  Addr_wait_R = Addr_wait_5
$$end
$$bwidth = 4+2+13+2+16+1

// -------------------------

// instantiate a RISC-V RV32I processor ; yup, that is that easy!
riscv small_cpu(
  output uint8  leds,
  output uint1  sdr_instr_add,   // pulse high to add an instruction
  output uint32 sdr_instr_l,     // instruction to add, low word
  output uint6  sdr_instr_h,     // instruction to add, high word
  output uint1  sdr_instr_reset, // pulse high to reset all
  output uint1  sdr_instr_run,   // maintain high to run
  input  uint8  sdr_read,        // value read from sdram
) <mem=2048> { // memory in bytes

  // =============== firmware in C language ===========================
  // ==================================================================
#include "sdram.h"

$$if not SIMULATION then
  void wait() { for (int w = 0 ; w < 10000 ; ++w) { asm volatile ("nop;"); } }
$$else
  void wait() { for (int w = 0 ; w < 100 ; ++w) { asm volatile ("nop;"); } }
$$end

  #define N_INSTR  (33u+0u) // +1u
  static const uint64_t sdram_instructions[N_INSTR] = {

      /* ---- Initialisation sequence (7 entries, indices 0-6) ------------- */
      // INSTR(CMD_dummy_WAIT_init, BANK0, Addr_wait_init,    DQM_NONE,  DataZ,          0),
      INSTR(CMD_PRECHARGE,       BANK0, Addr_precharge_all,DQM_NONE,  DataZ,          0),
      INSTR(CMD_dummy_WAIT,      BANK0, Addr_wait_2,       DQM_NONE,  DataZ,          0),
      INSTR(CMD_LOAD_MODE_REG,   BANK0, Addr_mode_reg,     DQM_NONE,  DataZ,          0),
      INSTR(CMD_dummy_WAIT,      BANK0, Addr_wait_4,       DQM_NONE,  DataZ,          0),
      INSTR(CMD_REFRESH,         BANK0, AddrZ,             DQM_NONE,  DataZ,          0),
      INSTR(CMD_dummy_WAIT,      BANK0, Addr_wait_16,      DQM_NONE,  DataZ,          0),

      /* ---- Write into row A (6 entries, indices 7-12) ------------------- */
      INSTR(CMD_PRECHARGE,       BANK0, AddrZ,             DQM_NONE,  DataZ,          0),
      INSTR(CMD_dummy_WAIT,      BANK0, Addr_wait_16,      DQM_NONE,  DataZ,          0),
      INSTR(CMD_ACTIVATE,        BANK0, AddrA_row,         DQM_NONE,  DataZ,          0),
      INSTR(CMD_dummy_WAIT,      BANK0, Addr_wait_2,       DQM_NONE,  DataZ,          0),
      INSTR(CMD_WRITE,           BANK0, AddrA_col,         DQM_WRITE, DATA_PATTERN_A, 1),
      INSTR(CMD_dummy_WAIT,      BANK0, Addr_wait_8,       DQM_NONE,  DataZ,          0),

      /* ---- Write into row B (6 entries, indices 13-18) ------------------ */
      INSTR(CMD_PRECHARGE,       BANK0, AddrZ,             DQM_NONE,  DataZ,          0),
      INSTR(CMD_dummy_WAIT,      BANK0, Addr_wait_16,      DQM_NONE,  DataZ,          0),
      INSTR(CMD_ACTIVATE,        BANK0, AddrB_row,         DQM_NONE,  DataZ,          0),
      INSTR(CMD_dummy_WAIT,      BANK0, Addr_wait_2,       DQM_NONE,  DataZ,          0),
      INSTR(CMD_WRITE,           BANK0, AddrB_col,         DQM_WRITE, DATA_PATTERN_B, 1),
      INSTR(CMD_dummy_WAIT,      BANK0, Addr_wait_8,       DQM_NONE,  DataZ,          0),

      // ---- Row-copy attempt (7 entries, indices 19-25) ------------------
      // -> activate A
      INSTR(CMD_PRECHARGE,       BANK0, AddrZ,             DQM_NONE,  DataZ,          0),
      INSTR(CMD_dummy_WAIT,      BANK0, Addr_wait_16,      DQM_NONE,  DataZ,          0),
      INSTR(CMD_ACTIVATE,        BANK0, AddrA_row,         DQM_NONE,  DataZ,          0),
      INSTR(CMD_dummy_WAIT,      BANK0, Addr_wait_8,       DQM_NONE,  DataZ,          0),
      // -> illegally activate B (no inter-bank wait)
      INSTR(CMD_PRECHARGE,       BANK0, AddrZ,             DQM_NONE,  DataZ,          0),
      //INSTR(CMD_dummy_WAIT,      BANK0, Addr_wait_2,       DQM_NONE,  DataZ,          0), // comment for row copy
      INSTR(CMD_ACTIVATE,        BANK0, AddrB_row,         DQM_NONE,  DataZ,          0),
      INSTR(CMD_dummy_WAIT,      BANK0, Addr_wait_8,       DQM_NONE,  DataZ,          0),

      /* ---- Read from row B (8 entries, indices 26-33) ------------------- */
      INSTR(CMD_PRECHARGE,       BANK0, AddrZ,             DQM_NONE,  DataZ,          0),
      INSTR(CMD_dummy_WAIT,      BANK0, Addr_wait_16,      DQM_NONE,  DataZ,          0),
      INSTR(CMD_ACTIVATE,        BANK0, AddrB_row,         DQM_NONE,  DataZ,          0),
      INSTR(CMD_dummy_WAIT,      BANK0, Addr_wait_2,       DQM_NONE,  DataZ,          0),
      INSTR(CMD_READ,            BANK0, AddrB_col,         DQM_NONE,  DataZ,          0),
      INSTR(CMD_dummy_WAIT,      BANK0, Addr_wait_R,       DQM_NONE,  DataZ,          0),
      INSTR(CMD_dummy_GET,       BANK0, Addr_no_wait,      DQM_NONE,  DataZ,          0),
      INSTR(CMD_dummy_WAIT,      BANK0, Addr_wait_16,      DQM_NONE,  DataZ,          0),
  };

  // C main
  void main() {
    leds(0);
    sdr_instr_run(0);
    wait(); // powerup
    // reset sdram controler content
    sdr_instr_reset(0); sdr_instr_reset(1);
    // add all isntructions
    for (int i=0;i<N_INSTR;++i) {
      sdr_instr_l((uint32_t)sdram_instructions[i]);
      sdr_instr_h(sdram_instructions[i] >> 32);
      sdr_instr_add(0); sdr_instr_add(1); // pulse to add instruction
    }
    // run the controller
    sdr_instr_run(1);
    // set the result
    while (1) {
      leds(sdr_read());
    }
    // sdr_instr_run(0);
  }

  // =============== end of firmware ==================================
  // ==================================================================
}

// -------------------------

unit main(
  output uint$NUM_LEDS$ leds,
$$if not ICARUS then
  // SDRAM
  output! uint1  sdram_cle,
  output! uint2  sdram_dqm,
  output! uint1  sdram_cs,
  output! uint1  sdram_we,
  output! uint1  sdram_cas,
  output! uint1  sdram_ras,
  output! uint2  sdram_ba,
  output! uint13 sdram_a,
$$if VERILATOR then
  output! uint1  sdram_clock,
  input   uint16 sdram_dq_i,
  output! uint16 sdram_dq_o,
  output! uint1  sdram_dq_en,
  // VGA (to be compiled with sdram_vga framework)
  output! uint1  video_clock,
  output! uint4  video_r,
  output! uint4  video_g,
  output! uint4  video_b,
  output! uint1  video_hs,
  output! uint1  video_vs
$$else
  output! uint1  sdram_clk,  // sdram chip clock != internal sdram_clock
  inout   uint16 sdram_dq,
$$end
$$end
)
$$if ULX3S or DE10NANO or DE2 or ICEPI_ZERO then
<@sdram_clock,!rst>
$$end
{

$$if not ICARUS then
uint1 rst(1);
clean_reset rstcond<@sdram_clock,!reset> (
  out   :> rst
);
$$else
uint1 sdram_clock(0);
uint3 clock_div(0);
uint1 compute_clock(0);
$$end

uint16 iter = 0;

// --- SDRAM

$$if not VERILATOR then
uint16 sdram_dq_i2(0); /// TODO: Silice, investigate why sdram_dq_i does not work (ulx3s)
uint16 reg_dq_i(0);
$$else
$$error('verilator TODO')
$$end

$$if ICARUS then
uint1  sdram_cle   (0);
uint2  sdram_dqm   (0);
uint1  sdram_cs    (0);
uint1  sdram_we    (0);
uint1  sdram_cas   (0);
uint1  sdram_ras   (0);
uint2  sdram_ba    (0);
uint13 sdram_a     (0);
uint16 sdram_dq    (0);
simul_sdram simul(
  sdram_clk <:  clock,
  sdram_cle <:  sdram_cle,
  sdram_dqm <:  sdram_dqm,
  sdram_cs  <:  sdram_cs,
  sdram_we  <:  sdram_we,
  sdram_cas <:  sdram_cas,
  sdram_ras <:  sdram_ras,
  sdram_ba  <:  sdram_ba,
  sdram_a   <:  sdram_a,
  sdram_dq  <:> sdram_dq
);
$$end

$$if ULX3S or DE10NANO or DE2 or ICEPI_ZERO then
  // --- clock
  uint1 video_clock   = 0;
  uint1 sdram_clock   = 0;
  uint1 pll_lock      = 0;
  uint1 compute_clock = 0;
  uint1 compute_reset = 0;
$$if ULX3S then
  $$print('ULX3S at 50 MHz compute clock, 100 MHz SDRAM')
  // pll_50_25_100_100ph180 clk_gen(
  pll clk_gen(
    clkin    <: clock,
    clkout0  :> compute_clock,
    clkout1  :> video_clock,
    clkout2  :> sdram_clock, // controller
    clkout3  :> sdram_clk,   // chip
    locked   :> pll_lock,
//    reset    :> rst
  );
$$end
$$if DE10NANO then
  $$print('de10nano at 50 MHz compute clock, 100 MHz SDRAM')
  uint1 not_pll_lock = 0;
  pll_50_25_100_100ph180 clk_gen(
    refclk   <: clock,
    rst      <: not_pll_lock,
    outclk_0 :> compute_clock,
    outclk_1 :> video_clock,
    outclk_2 :> sdram_clock, // controller
    outclk_3 :> sdram_clk,   // chip
    locked   :> pll_lock
  );
$$end
$$if DE2 then
  $$print('de2, 100 MHz SDRAM')
  uint1 not_pll_lock = 0;
  pll clk_gen(
    inclk0   <: clock,
    c0       :> video_clock,
    c1       :> sdram_clock, // controller
    c2       :> sdram_clk,   // chip
    locked   :> pll_lock
  );
$$end
$$if ICEPI_ZERO then
  $$print('icepi zero at 50 MHz compute clock, 100 MHz SDRAM')
  pll_50_25_100_100ph180 clk_gen(
    clkin    <: clock,
    clkout0  :> compute_clock,
    clkout1  :> video_clock,
    clkout2  :> sdram_clock, // controller
    clkout3  :> sdram_clk,   // chip
    locked   :> pll_lock
  );
$$end
$$end

  small_cpu cpu<@compute_clock>;

$$if not VERILATOR then
$$if ULX3S_IO then
  inout16_ff_ulx3s ioset(
    clock           <:  sdram_clock,
    io_pin          <:> sdram_dq,
    io_write       <::  reg_dq_o,
    io_read         :>  sdram_dq_i2,
    io_write_enable <:: reg_dq_en
  );
  out1_ff_ulx3s  off_sdram_cs (clock <: sdram_clock, pin :> sdram_cs , d <:: reg_sdram_cs );
  out1_ff_ulx3s  off_sdram_cas(clock <: sdram_clock, pin :> sdram_cas, d <:: reg_sdram_cas);
  out1_ff_ulx3s  off_sdram_ras(clock <: sdram_clock, pin :> sdram_ras, d <:: reg_sdram_ras);
  out1_ff_ulx3s  off_sdram_we (clock <: sdram_clock, pin :> sdram_we , d <:: reg_sdram_we );
  out2_ff_ulx3s  off_sdram_dqm(clock <: sdram_clock, pin :> sdram_dqm, d <:: reg_sdram_dqm);
  out2_ff_ulx3s  off_sdram_ba (clock <: sdram_clock, pin :> sdram_ba , d <:: reg_sdram_ba );
  out13_ff_ulx3s off_sdram_a  (clock <: sdram_clock, pin :> sdram_a  , d <:: reg_sdram_a  );
$$elseif DE10NANO then
  inout16_set ioset(
    clock           <:  sdram_clock,
    io_pin          <:> sdram_dq,
    io_write        <:  reg_dq_o,
    io_read         :>  sdram_dq_i2,
    io_write_enable <:  reg_dq_en
  );
$$else
  inout16_set ioset(
    clock           <:  sdram_clock,
    io_pin          <:> sdram_dq,
    io_write        <:  reg_dq_o,
    io_read         :>  sdram_dq_i2,
    io_write_enable <:  reg_dq_en
  );
$$end
$$end

  uint1   reg_sdram_cs  (0);
  uint1   reg_sdram_cas (1);
  uint1   reg_sdram_ras (1);
  uint1   reg_sdram_we  (1);
  uint2   reg_sdram_dqm (0);
  uint2   reg_sdram_ba  (0);
  uint13  reg_sdram_a   (0);
  uint16  reg_dq_o      (0);
  uint1   reg_dq_en     (0);

  // CMD BANK ADDR DQM DATA DQEN
  bram uint$bwidth$ instructions[64] = {pad(0)};
  uint6 n_instr = 0;
  uint6 pc      = 0;
  uint1 run_trigger = 0;

  always_before {
    instructions.wenable = 0;
    sdram_cle   = 1;
$$if not ULX3S_IO then
    sdram_cs    = reg_sdram_cs;
    sdram_cas   = reg_sdram_cas;
    sdram_ras   = reg_sdram_ras;
    sdram_we    = reg_sdram_we;
    sdram_dqm   = reg_sdram_dqm;
    sdram_ba    = reg_sdram_ba;
    sdram_a     = reg_sdram_a;
$$if VERILATOR then
    sdram_dq_o  = reg_dq_o;
    sdram_dq_en = reg_dq_en;
$$end
$$end
$$if VERILATOR then
    // sdram clock for verilator simulation
    sdram_clock = clock;
$$end
$$if DE2 then
    compute_clock = sdram_clock;
$$end
$$if ICARUS then
    sdram_clock   = clock;
    compute_clock = clock_div == 4 ? ~compute_clock : compute_clock;
    clock_div     = clock_div == 4 ? 0 : clock_div + 1;
$$end
    leds         = cpu.leds[0,8];
    cpu.sdr_read = reg_dq_i[0,8];
  }

  algorithm {

    while (1) {

      int5 cnt    = -1;
      pc          = run_trigger ? 0 : n_instr; // TODO rework trigger/run
      run_trigger = 0;
      while (pc != n_instr && cpu.sdr_instr_run) {
        __display("IN LOOP ---------------");
        uint$bwidth$ instr = instructions.rdata;
        if (cnt[4,1]) {__display("executing instruction %b (pc == %d)",instr,pc);}
        uint4 cmd          = instr[$bwidth-4$     , 4];
        __display("cmd: %b",cmd);
        if (cmd[3,1] & cmd[0,1]) { /// wait / get
          if (cnt[4,1]) { __display("wait: %b",instr[$bwidth-4-2-13$  ,13]); }
          cnt     = ~cnt[4,1] ? (cnt - 1) : instr[$bwidth-4-2-13$  ,5];
          (reg_sdram_cs,reg_sdram_ras,reg_sdram_cas,reg_sdram_we) = command({1b0,3b111});
          __write(".");
          if (cnt[4,1]) { __display("done"); }
          reg_dq_i = ~cmd[2,1] ? sdram_dq_i2 : reg_dq_i;
          if (~cmd[2,1]) { __display("get: %x",sdram_dq_i2); }
        } else {
          (reg_sdram_cs,reg_sdram_ras,reg_sdram_cas,reg_sdram_we) = command(cmd);
          reg_sdram_ba  = instr[$bwidth-4-2   $, 2];
          reg_sdram_a   = instr[$bwidth-4-2-13$,13];
          reg_sdram_dqm = instr[         $1+16$, 2];
          reg_dq_o      = instr[              1,16];
          reg_dq_en     = instr[              0, 1];
  $$if SIMULATION then
          //__display("sdram_ba:%b sdram_a:%b",reg_sdram_ba,reg_sdram_a);
          switch (cmd)
          {
            case 4b$CMD_NOP$: {
              __display("null");
            }
            case 4b$CMD_PRECHARGE$: {
              __display("precharge");
            }
            case 4b$CMD_ACTIVATE$: {
              __display("activate");
            }
            case 4b$CMD_WRITE$: {
              __display("write");
            }
            case 4b$CMD_READ$: {
              __display("read");
            }
            case 4b$CMD_LOAD_MODE_REG$: {
              __display("load mode reg");
            }
            case 4b$CMD_REFRESH$: {
              __display("refresh");
            }
            default: {
              __display("[error] command %b unknown (pc=%d)",cmd,pc);
              __finish();
            }
          }
  $$end
        }
        pc                 = cnt[4,1] ? pc + 1 : pc;
      }

    }
  }

  always_after {
    // take orders from the CPU
    uint1 c_instr_reset(0);
    uint1 c_instr_add(0);
    uint1 c_instr_run(0);
    $$if SIMULATION then
    if (cpu.sdr_instr_add & ~c_instr_add) {
      __display("adding instruction %b at %d : ",{cpu.sdr_instr_h,cpu.sdr_instr_l},instructions.addr);
    }
    $$end
    // detect pulse fronts and act
    instructions.addr    = cpu.sdr_instr_run ? pc : n_instr;
    instructions.wdata   = {cpu.sdr_instr_h,cpu.sdr_instr_l};
    instructions.wenable = (cpu.sdr_instr_add & ~c_instr_add);
    n_instr = (cpu.sdr_instr_add   & ~c_instr_add  ) ? n_instr + 1
            : (cpu.sdr_instr_reset & ~c_instr_reset) ? 0
            : n_instr;
    if (cpu.sdr_instr_run & ~c_instr_run) { run_trigger = 1; }
    // retain value to detect pulse front
    c_instr_reset = cpu.sdr_instr_reset;
    c_instr_add   = cpu.sdr_instr_add;
    c_instr_run   = cpu.sdr_instr_run;
     //__display("instructions.addr: %d",instructions.addr);
  }

}
