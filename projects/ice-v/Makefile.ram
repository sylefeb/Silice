
.DEFAULT: SOCs/ice-v-soc-ram-2x.si
		silice-make.sh -s SOCs/ice-v-soc-ram-2x.si -b $@ -p basic,uart,pmod_qqspi,spiscreen_extra -o BUILD_$(subst :,_,$@) -t shell $(ARGS)

verilator: SOCs/ice-v-soc-ram-2x.si data.raw
		# silice-make.sh -s SOCs/ice-v-soc-ram-2x.si -b $@ -p basic,spiscreen -o BUILD_$(subst :,_,$@) $(ARGS)
		silice-make.sh -s SOCs/ice-v-soc-ram-2x.si -b $@ -p basic -o BUILD_$(subst :,_,$@) $(ARGS)

data.raw:
		cp ./compile/build/code.bin data.raw

clean:
	rm -rf BUILD_*
