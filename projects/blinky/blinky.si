unit main(output uint8 leds)
{
  uint24 cnt = 0; // cnt resets at 0
  //   ^ 24 bits width

  always_before {
    leds   = cnt[ 16 , 8 ]; // LEDs track the top bits of cnt
    // from bit 16 ^   ^ take 8 bits
  }
  algorithm {
    while (1) {         // run forever
      cnt  = cnt + 1;   // increase cnt (loops back to zero after overflow)
      __display("LEDs: %b",leds); // only shown in simulation
    }
  }

}
