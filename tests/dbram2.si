// Dual-port bram test, with different clocks

unit main(output uint8 leds)
{

  uint9 n    = 0;
  uint8 cnt  = 0;

  dualport_bram uint8 mem<@cnt[0,1],@cnt[1,1]>[8] = {10,20,30,40,50,60,70,80};

  algorithm {

    mem.wenable0 = 0;
    mem.wenable1 = 0;
    __display("start");
    while (n < 32) {
      __display("%d | %b] %d %d",cnt,cnt[0,2],mem.rdata0,mem.rdata1);
      n = n + 1;
    }

  }

  always_after {
    cnt       = cnt + 1;
    mem.addr0 = cnt[1,8];
    mem.addr1 = cnt[2,8];
  }


}
